# ============================================
# REQUIRED - LLM API Key
# ============================================
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# OPTIONAL - Azure Cost Management (for production)
# Demo works with mock data if not configured
# ============================================
# To set up with GitHub Student Azure credits:
# 1. Redeem Azure credits at https://azure.microsoft.com/en-us/free/students/
# 2. Create an App Registration in Azure AD
# 3. Assign "Cost Management Reader" role
# 4. Fill in credentials below:
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ============================================
# OPTIONAL - GitLab CI/CD (for production)
# Demo works with mock data if not configured
# ============================================
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=

# ============================================
# Local Settings (usually no changes needed)
# ============================================
CHROMA_PERSIST_DIR=data/vector_db
COLLECTION_NAME=abc_company_docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=llama-3.3-70b-versatile
